# Empty API URL enables clearly labelled preview/download mode.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Leave empty for a private preview. Set to your public HTTPS domain at launch.
NEXT_PUBLIC_SITE_URL=
# Official business number only, international digits without + or spaces.
# If empty, the WhatsApp button is hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=
